# Redirections de lesponctuelles.com vers lesponctuelles.be
# Genere par build_htaccess.py a partir de l'export du plugin Redirection.
# Ce dossier ne sert qu'a rediriger : aucun site n'y est installe.

<IfModule mod_rewrite.c>
RewriteEngine On

# Validation du certificat SSL (Let's Encrypt) : ne pas rediriger.
RewriteRule ^\.well-known/ - [L]

# Accueil. Les parametres propres a l'ancien WordPress sont abandonnes,
# les autres (utm, fbclid...) sont transmis.
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|attachment_id|cat|tag|s|m|author|preview|rest_route|post_type|feed|amp)= [NC]
RewriteRule ^$ https://lesponctuelles.be/ [R=301,L,QSD]
RewriteRule ^$ https://lesponctuelles.be/ [R=301,L]

# Pages, articles, produits et categories ayant un equivalent (144 regles).
RewriteRule ^on-mange-ou-ce-soir-1/?$ https://lesponctuelles.be/blog/ [R=301,L,NC]
RewriteRule ^chouchou-on-fait-quoi-ce-week-end-2-29-30-avril/?$ https://lesponctuelles.be/blog/ [R=301,L,NC]
